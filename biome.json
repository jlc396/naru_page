{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": true }],
            "identifierOrder": "lexicographic"
          }
        }
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": {
          "level": "on",
          "options": { "style": "separatedType" }
        },
        "noNonNullAssertion": "off"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "useEditorconfig": true
  }
}
